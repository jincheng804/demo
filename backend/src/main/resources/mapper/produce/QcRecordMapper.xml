<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beefarm.produce.mapper.QcRecordMapper">

    <resultMap id="qcMap" type="com.beefarm.produce.entity.QcRecord">
        <id property="id" column="id"/>
        <result property="batchId" column="batch_id"/>
        <result property="productBatchNo" column="product_batch_no"/>
        <result property="productName" column="product_name"/>
        <result property="qcItems" column="qc_items"/>
        <result property="qcResult" column="qc_result"/>
        <result property="qcValue" column="qc_value"/>
        <result property="inspector" column="inspector"/>
        <result property="qcDate" column="qc_date"/>
    </resultMap>

    <select id="selectQcPage" resultMap="qcMap">
        SELECT q.*, p.product_batch_no, p.product_name
        FROM biz_qc_record q
                 LEFT JOIN biz_product_batch p ON p.id = q.batch_id AND p.deleted = 0
        WHERE q.deleted = 0
        <if test="qc.batchId != null">
            AND q.batch_id = #{qc.batchId}
        </if>
        <if test="qc.qcResult != null">
            AND q.qc_result = #{qc.qcResult}
        </if>
        ORDER BY q.qc_date DESC, q.id DESC
    </select>
</mapper>
