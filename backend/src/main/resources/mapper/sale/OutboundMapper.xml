<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.beefarm.sale.mapper.OutboundMapper">

    <resultMap id="outboundMap" type="com.beefarm.sale.entity.Outbound">
        <id property="id" column="id"/>
        <result property="outboundNo" column="outbound_no"/>
        <result property="customerId" column="customer_id"/>
        <result property="customerName" column="customer_name"/>
        <result property="totalQty" column="total_qty"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="outboundDate" column="outbound_date"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectOutboundPage" resultMap="outboundMap">
        SELECT o.*, c.customer_name
        FROM biz_outbound o
                 LEFT JOIN biz_customer c ON c.id = o.customer_id AND c.deleted = 0
        WHERE o.deleted = 0
        <if test="outbound.outboundNo != null and outbound.outboundNo != ''">
            AND o.outbound_no LIKE CONCAT('%', #{outbound.outboundNo}, '%')
        </if>
        <if test="outbound.customerId != null">
            AND o.customer_id = #{outbound.customerId}
        </if>
        <if test="outbound.status != null">
            AND o.status = #{outbound.status}
        </if>
        ORDER BY o.outbound_date DESC, o.id DESC
    </select>
</mapper>
