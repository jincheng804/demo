# Copy to an untracked private file and load as process environment or systemd EnvironmentFile.
# Spring Boot does not automatically read .env files.
BEE_SERVER_ADDRESS=127.0.0.1
BEE_SERVER_PORT=8090
BEE_DB_URL=jdbc:mysql://localhost:3306/bee_farm?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
BEE_DB_USERNAME=bee
BEE_DB_PASSWORD=
# Set a persistent random secret of at least 64 bytes.
BEE_JWT_SECRET=
# Replace local addresses with the actual site URL and allowed origins when deploying.
BEE_TRACE_BASE_URL=http://localhost:5173
BEE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
